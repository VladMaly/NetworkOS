# Shared with the website (same value in website/.env.local).
# Make one: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTS_SECRET=

# OpenRouter (openrouter.ai/keys), used by the agents and by Cognee
OPENROUTER_API_KEY=

# Optional
# AGENT_MODEL=deepseek/deepseek-v4.1-flash   # any OpenRouter model id
# RESEARCH_WEB=0            # turn off web search in Research
# DATA_DIR=/data            # Railway: the volume's mount path. Locally defaults to ./data
# Cognee settings (LLM_*, EMBEDDING_*) have defaults in app/config.py and can be overridden here.

# Band (app.band.ai → Agents → Connect remote agent). One remote agent each; copy its ID, API key and handle.
# Without these, handoffs are only recorded locally.
PLANNER_AGENT_ID=
PLANNER_API_KEY=
PLANNER_HANDLE=
RESEARCH_AGENT_ID=
RESEARCH_API_KEY=
RESEARCH_HANDLE=
STRATEGIST_AGENT_ID=
STRATEGIST_API_KEY=
STRATEGIST_HANDLE=
OUTREACH_AGENT_ID=
OUTREACH_API_KEY=
OUTREACH_HANDLE=

# Cognee Cloud (optional): push each user's memory graph to your Cognee instance after it's built, so contacts show up
# under Datasets in the Cognee web app (dataset networkos_<user>). Instance URL and API key from cognee.ai.
NETWORKOS_COGNEE_CLOUD_URL=
NETWORKOS_COGNEE_CLOUD_KEY=
