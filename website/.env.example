# Auth.js: make one with `npx auth secret`
AUTH_SECRET=
# Google OAuth client (see docs/setup.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The agents service (agents/). Locally http://localhost:8000; in production the Railway URL.
AGENTS_URL=http://localhost:8000
# Same value as AGENTS_SECRET in agents/.env
AGENTS_SECRET=

# Local only: with Google sign-in not configured, `npm run dev` signs you in as this ID.
# DEV_USER_ID=dev-founder
# DEV_USER_NAME=Dev Founder
